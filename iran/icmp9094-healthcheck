#!/bin/bash
# Multi-Carrier ICMP Tunnel Health Monitor (Iran Gateway)
# Probes each WireGuard carrier independently. Auto-heals degraded carriers.

set -euo pipefail

STATE_DIR=/run/icmp9094-health
mkdir -p "$STATE_DIR"

CARRIERS=(
  "wg9094:10.77.94.2"
  "wg9095:10.77.95.2"
  "wg9096:10.77.96.2"
)

for c in "${CARRIERS[@]}"; do
  dev="${c%%:*}"
  peer_ip="${c#*:}"
  state_file="$STATE_DIR/$dev.failures"

  if systemctl is-active --quiet "udp2raw-$dev.service" && \
     systemctl is-active --quiet "wg-quick@$dev.service" && \
     ping -n -q -I "$dev" -c 1 -W 3 "$peer_ip" >/dev/null 2>&1; then
    echo 0 > "$state_file"
  else
    n=0
    [ -f "$state_file" ] && read -r n < "$state_file" || true
    n=$((n + 1))
    echo "$n" > "$state_file"
    logger -t icmp9094-health "Carrier $dev health failure $n/3 (target $peer_ip)"

    if [ "$n" -ge 3 ]; then
      logger -t icmp9094-health "Carrier $dev failed 3 times; restarting udp2raw-$dev and wg-quick@$dev"
      systemctl stop "wg-quick@$dev.service" 2>/dev/null || true
      systemctl restart "udp2raw-$dev.service"
      sleep 2
      systemctl start "wg-quick@$dev.service"
      echo 0 > "$state_file"
    fi
  fi
done
