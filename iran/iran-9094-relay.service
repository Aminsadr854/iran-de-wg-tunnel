[Unit]
Description=Forward Iran public 9094 TCP/UDP over WireGuard carriers (wg9094, wg9095, wg9096)
After=network-online.target wg-quick@wg9094.service wg-quick@wg9095.service wg-quick@wg9096.service
Wants=network-online.target wg-quick@wg9094.service wg-quick@wg9095.service wg-quick@wg9096.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/iran-9094-relay start
ExecStop=/usr/local/sbin/iran-9094-relay stop
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
