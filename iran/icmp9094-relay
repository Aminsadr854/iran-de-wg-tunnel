#!/bin/bash
# Backward-compatibility wrapper for iran-9094-relay
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -x "$DIR/iran-9094-relay" ]; then
  exec "$DIR/iran-9094-relay" "$@"
elif [ -x /usr/local/sbin/iran-9094-relay ]; then
  exec /usr/local/sbin/iran-9094-relay "$@"
else
  echo "Error: iran-9094-relay not found." >&2
  exit 1
fi
