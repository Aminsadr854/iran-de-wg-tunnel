[Unit]
Description=udp2raw client (WireGuard transport, faketcp)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/udp2raw -c -l 127.0.0.1:4097 -r <GERMANY_PUBLIC_IP>:4096 -k "<SHARED_SECRET>" --raw-mode faketcp -a --cipher-mode xor
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
