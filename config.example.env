# Plain KEY=value data, never executed. No quotes, expansions, or shell commands.
ROLE=foreign
# Required on Foreign; externally reachable IPv4, not a hostname.
FOREIGN_PUBLIC_IP=203.0.113.10
PUBLIC_LISTEN_PORT=9094
APPLICATION_PORT=9094
CARRIER_COUNT=3
WIREGUARD_MTU=900
CARRIER_PORT_BASE=42094
WG_PORT_BASE=51894
LOCAL_PORT_BASE=53894
TUNNEL_NETWORK=10.203.0.0/24
# Empty interface: detected from physical peer/default route.
NETWORK_INTERFACE=
CPU_AFFINITY=yes
SELF_HEAL=no
HEALTH_FAILURES=3
HEALTH_COOLDOWN=300
HANDSHAKE_MAX_AGE=180
# Iran only: protected pairing JSON transferred securely from Foreign.
PEER_FILE=

# Multi-endpoint availability & automatic failover (Iran role)
PRIMARY_FOREIGN_ENDPOINT=203.0.113.10
SECONDARY_FOREIGN_ENDPOINT=203.0.113.11
# Or a list of administrator-owned Foreign endpoints:
FOREIGN_ENDPOINTS=203.0.113.10 203.0.113.11
AUTO_FAILOVER=yes
AUTO_FAILBACK=no
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=5
FAILOVER_COOLDOWN=300
