[Unit]
Description=udp2raw server (WireGuard transport, faketcp)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/udp2raw -s -l 0.0.0.0:4096 -r 127.0.0.1:443 -k "<SHARED_SECRET>" --raw-mode faketcp -a --cipher-mode xor
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
